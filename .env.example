# Environment variables declared in this file are automatically made available to Prisma and Next.js.
# Local Postgres default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myshop?schema=public"

# Supabase direct connection (diisi nanti jika migrasi ke Supabase dengan connection pooler):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Next Public variables (Client side)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MyShop"
